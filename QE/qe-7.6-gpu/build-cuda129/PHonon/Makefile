	cd /var/local/qe/projects/qe-7.6-gpu/build-cuda129 && $(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 PHonon/CMakeFiles/ph.dir/rule
.PHONY : PHonon/CMakeFiles/ph.dir/rule

