	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 qe_pp
.PHONY : qe_pp

# fast build rule for target.
qe_pp/fast:
	$(MAKE) $(MAKESILENT) -f PP/CMakeFiles/qe_pp.dir/build.make PP/CMakeFiles/qe_pp.dir/build
.PHONY : qe_pp/fast

