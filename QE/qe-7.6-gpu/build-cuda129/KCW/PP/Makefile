	cd /var/local/qe/projects/qe-7.6-gpu/build-cuda129 && $(MAKE) $(MAKESILENT) -f KCW/PP/CMakeFiles/qe_kcwpp.dir/build.make KCW/PP/CMakeFiles/qe_kcwpp.dir/sh_setup.f90.s
.PHONY : sh_setup.f90.s

